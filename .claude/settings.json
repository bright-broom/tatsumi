{
  "permissions": {
    "allow": [
      "Bash(npm ci)",
      "Bash(npm run typecheck)",
      "Bash(npm run build)",
      "Bash(npm run verify)",
      "Bash(npm run smoke)",
      "Bash(bash scripts/smoke.sh:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ],
    "deny": [
      "Bash(npm run lint:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)"
    ]
  }
}
