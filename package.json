{
  "name": "tatsumi-site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "verify": "npm run typecheck && npm run lint && npm run images:check && npm run build",
    "smoke": "bash scripts/smoke.sh",
    "images:sizes": "node scripts/image-sizes.mjs",
    "images:check": "node scripts/image-sizes.mjs --check",
    "a11y": "node scripts/a11y.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "clsx": "^2.1.1",
    "embla-carousel-autoplay": "^8.6.0",
    "embla-carousel-fade": "^8.6.0",
    "embla-carousel-react": "^8.6.0",
    "next": "^15.5.28",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.90.0",
    "yet-another-react-lightbox": "^3.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "axe-core": "4.14.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.28",
    "image-size": "^2.0.4",
    "playwright": "1.64.0",
    "typescript": "5.9.3"
  },
  "overrides": {
    "next": {
      "postcss": "^8.5.30"
    }
  }
}
